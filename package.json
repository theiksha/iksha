{
  "name": "iksha",
  "version": "0.0.3",
  "private": true,
  "homepage": "https://theiksha.org",
  "type": "module",

  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",

    
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",


    "build:domain": "cross-env BASE_PATH=/ vite build",
    "deploy:domain": "npm run build:domain && gh-pages -d build -f",

  
    "build:gh": "cross-env BASE_PATH=/iks vite build",
    "deploy:gh": "npm run build:gh && gh-pages -d build -f"
  },

  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.45.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.36.0",
    "globals": "^15.0.0",
    "mdsvex": "^0.12.3",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^3.1.2",
    "sass": "^1.77.8",
    "svelte": "^4.2.7",
    "svelte-check": "^3.6.0",
    "svelte-preprocess": "^6.0.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.0.3"
  },

  "dependencies": {
    "gh-pages": "^6.3.0"
  },

  "engines": {
    "node": "20.x"
  }
}
